{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/know-how", "destination": "/know-how.html" },
    { "source": "/about", "destination": "/about.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
